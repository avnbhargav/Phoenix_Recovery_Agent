    {"code": "card_expired", "category": "customer_action_required", "retry_delay_hours": null, "requires_customer_action": true, "notes": "~25% of all failures per Stripe data. Retrying the same card is pointless — send card-update flow immediately."},
    {"code": "card_number_invalid", "category": "customer_action_required", "retry_delay_hours": null, "requires_customer_action": true},
