    {"code": "transaction_limit_exceeded", "category": "limit_based_retry", "retry_delay_hours": 24, "requires_customer_action": true, "notes": "Card-level credit/debit limit; may need a different instrument."},
    {"code": "transaction_frequency_limit_exceeded", "category": "limit_based_retry", "retry_delay_hours": 24, "requires_customer_action": false, "notes": "NPCI frequency limit for UPI."},
