    {"code": "credit_limit_exceeded", "category": "limit_based_retry", "retry_delay_hours": 24, "requires_customer_action": true},

    {"code": "debit_instrument_blocked", "category": "hard_stop_compliance", "retry_delay_hours": null, "requires_customer_action": true, "notes": "Card blocked by issuer or customer. No retry — customer must use a different instrument."},
    {"code": "payment_risk_check_failed", "category": "hard_stop_compliance", "retry_delay_hours": null, "requires_customer_action": true, "notes": "Risk check failed at Razorpay, gateway, or issuer level."},
    {"code": "transaction_on_vpa_restricted", "category": "hard_stop_compliance", "retry_delay_hours": null, "requires_customer_action": true},
    {"code": "compliance_violation", "category": "hard_stop_compliance", "retry_delay_hours": null, "requires_customer_action": false, "notes": "Never retry automatically. Route to manual/compliance review."},
    {"code": "card_declined", "category": "hard_stop_compliance", "retry_delay_hours": null, "requires_customer_action": true},
    {"code": "user_not_eligible", "category": "hard_stop_compliance", "retry_delay_hours": null, "requires_customer_action": true, "notes": "Failed eligibility/credit check."}
  ]
